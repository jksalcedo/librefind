    <string name="help_app_name_desc">Kullanıcıların uygulamayı tanıdığı şekildeki görünen ad (örneğin, \"Signal\", \"Firefox\", \"VLC\").</string>
    <string name="help_app_name_tip">Uygulamanın web sitesinde veya mağaza listesinde yer alan resmi adı kullanın.</string>
